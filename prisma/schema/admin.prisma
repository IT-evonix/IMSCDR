// Admin Model
model Admin {
  id            Int            @id @default(autoincrement())
  name          String?
  email         String         @unique
  password      String
  role          String         @default("Administrator")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  newsEvents    NewsEvent[]

  @@map("admins")
}
