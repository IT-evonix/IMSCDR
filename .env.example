# Application Server Port & Environment
PORT=3000

# Environment Mode: 'development' (local) or 'production' (live Plesk server)
NODE_ENV=development
# NODE_ENV=production


# Database Configuration Placeholder
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public

# Contact Form Storage Mode: 'excel' (temporary) or 'database' (PostgreSQL)
CONTACT_STORAGE_MODE=excel

# App & API Base URLs (Local vs Live Plesk Server)
# Local Development:
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Live Plesk Production Domain (Uncomment & replace domain when live):
# APP_URL=https://yourdomain.com
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# JWT & Security Secrets Placeholder
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=24h
